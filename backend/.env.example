# Copy this file to `.env` (which is gitignored) and adjust as needed.
# The backend reads these variables on startup via python-dotenv.

# SQLAlchemy database URL.
# Default: local MySQL started by docker-compose.yml.
GRE_DATABASE_URL=mysql+pymysql://gre:gre@localhost:3306/gre
#
# Zero-dependency alternative — no Docker, no MySQL — using a local SQLite file:
# GRE_DATABASE_URL=sqlite:///./gre.db

# Comma-separated list of browser origins allowed by CORS.
# Default: the Vite dev server.
GRE_CORS_ORIGINS=http://localhost:5173
